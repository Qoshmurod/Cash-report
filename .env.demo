# DEMO sozlamalari — faqat o'z kompyuteringizda sinash uchun. Serverda ishlatmang!
# Ishga tushirish:  copy .env.demo .env   (Mac/Linux: cp .env.demo .env)
#                   docker compose up -d --build
# Keyin: http://localhost:3000  —  login: admin01  parol: admin01
POSTGRES_PASSWORD="demo-db-parol"
NUXT_SESSION_SECRET="demo-maxfiy-kalit-faqat-lokal-sinov-uchun-123456"
BOOTSTRAP_ADMIN_TOKEN="demo-token"
COOKIE_SECURE="false"
APP_TZ_OFFSET_MINUTES="300"
# Baza bo'sh bo'lsa, shu super admin avtomatik yaratiladi (faqat demo uchun yoqilgan).
AUTO_CREATE_ADMIN="true"
BOOTSTRAP_ADMIN_USERNAME="admin01"
BOOTSTRAP_ADMIN_PASSWORD="admin01"
