generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Patient {
  id        Int       @id @default(autoincrement())
  fullName  String
  phone     String?
  birthYear Int?
  address   String?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
  appointments Appointment[]
  contractClients ContractClient[]

  @@index([fullName])
  @@index([phone])
}

model Payment {
  id         Int      @id @default(autoincrement())
  patientId  Int
  department String
  service    String?
  amount     Int
  note       String?
  createdAt  DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  method     PaymentMethod @default(CASH)
  serviceId  Int?
  serviceRef Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  doctorId   Int?
  doctor     Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  paymentServices PaymentService[]
  contractId Int?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdById Int?
  createdBy   User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  editedAt    DateTime?
  editReason  String?

  @@index([createdAt])
  @@index([department])
  @@index([patientId])
  @@index([doctorId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CONTRACT
}

enum AppointmentStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Doctor {
  id           Int           @id @default(autoincrement())
  fullName     String
  specialty    String?
  phone        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  payments     Payment[]
  user         User?
}

model Service {
  id           Int       @id @default(autoincrement())
  name         String
  department   String?
  price        Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  payments     Payment[]
  appointments Appointment[]
  paymentSelections PaymentService[]
  @@unique([name, department])
  @@index([name])
}

model PaymentService {
  paymentId Int
  serviceId Int
  // Service price at the time of payment; used to confirm received lines at day close.
  amount    Int     @default(0)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  @@id([paymentId, serviceId])
  @@index([serviceId])
}

model Appointment {
  id          Int               @id @default(autoincrement())
  patientId   Int
  doctorId    Int?
  serviceId   Int?
  status      AppointmentStatus @default(WAITING)
  notes       String?
  scheduledAt DateTime          @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  service     Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  @@index([status, scheduledAt])
  @@index([patientId])
}

// ADMIN is a legacy value: such accounts are promoted to SUPER_ADMIN at server start.
// OPERATOR means a regular staff member whose access comes from a custom Role and direct grants.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  departments String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  passwordHash         String
  passwordFingerprint  String?
  role                 UserRole  @default(OPERATOR)
  mustChangePassword   Boolean   @default(false)
  disabled             Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sessions             Session[]
  permissions          UserPermission[]
  doctorId             Int?      @unique
  doctor               Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  fullName             String?
  phone                String?
  position             String?
  roleId               Int?
  customRole           Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  lastLoginAt          DateTime?
  createdPayments      Payment[] @relation("PaymentCreatedBy")

  @@index([role])
}

model Permission {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  users UserPermission[]
  roles RolePermission[]
}

model UserPermission {
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  // canGrant lets this user hand the same permission to other staff (set only by super admin).
  canGrant     Boolean    @default(false)
  grantedById  Int?
  createdAt    DateTime   @default(now())
  @@id([userId, permissionId])
}

model Session {
  id         String   @id
  userId     Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Super admin activity is intentionally never written to LoginEvent or AuditLog.
model LoginEvent {
  id        Int      @id @default(autoincrement())
  userId    Int?
  username  String
  type      String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  username  String
  action    String
  entity    String
  entityId  String?
  summary   String
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entity])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Contract {
  id              Int              @id @default(autoincrement())
  number          String
  organization    String
  startDate       DateTime?
  endDate         DateTime?
  note            String?
  active          Boolean          @default(true)
  fileName        String?
  fileMime        String?
  fileData        Bytes?
  clientsFileName String?
  createdById     Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clients         ContractClient[]
  payments        Payment[]
  letters         GuaranteeLetter[]

  @@index([organization])
}

model ContractClient {
  id         Int      @id @default(autoincrement())
  contractId Int
  patientId  Int
  position   String?
  note       String?
  createdAt  DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([contractId, patientId])
  @@index([patientId])
}

model GuaranteeLetter {
  id          Int       @id @default(autoincrement())
  title       String
  kind        String    @default("LETTER")
  contractId  Int?
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  note        String?
  fileName    String
  fileMime    String
  fileData    Bytes
  createdById Int?
  createdAt   DateTime  @default(now())

  @@index([kind])
}

model DayClosure {
  id           Int      @id @default(autoincrement())
  date         String   @unique
  total        Int
  count        Int
  byMethod     Json
  note         String?
  closedById   Int?
  closedByName String
  createdAt    DateTime @default(now())
  items        DayClosureItem[]
}

// One confirmed line of a closed day: a service of a payment (or the whole payment) and the amount received.
model DayClosureItem {
  id        Int        @id @default(autoincrement())
  closureId Int
  closure   DayClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)
  paymentId Int
  serviceId Int?
  label     String
  method    String
  amount    Int

  @@index([closureId])
  @@index([paymentId])
}
