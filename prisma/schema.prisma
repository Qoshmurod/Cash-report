generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Patient {
  id        Int       @id @default(autoincrement())
  fullName  String
  phone     String?
  birthYear Int?
  address   String?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
  appointments Appointment[]

  @@index([fullName])
  @@index([phone])
}

model Payment {
  id         Int      @id @default(autoincrement())
  patientId  Int
  department String
  departmentId Int?
  service    String?
  amount     Int
  note       String?
  createdAt  DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  method     PaymentMethod @default(CASH)
  serviceId  Int?
  serviceRef Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  doctorId   Int?
  doctor     Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  cashierId  Int?
  cashier    User? @relation("CashierPayments", fields: [cashierId], references: [id], onDelete: SetNull)
  departmentRef Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  deletedAt DateTime?
  paymentServices PaymentService[]

  @@index([createdAt])
  @@index([department])
  @@index([patientId])
  @@index([doctorId])
  @@index([departmentId])
  @@index([cashierId])
  @@index([deletedAt])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum AppointmentStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Doctor {
  id           Int           @id @default(autoincrement())
  fullName     String
  specialty    String?
  phone        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  payments     Payment[]
  user         User?
}

model Service {
  id           Int       @id @default(autoincrement())
  name         String
  department   String?
  departmentId Int?
  departmentRef Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  price        Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  payments     Payment[]
  appointments Appointment[]
  paymentSelections PaymentService[]
  @@unique([name, department])
  @@index([name])
  @@index([departmentId])
}

model Department {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]
  payments  Payment[]
  @@index([active])
}

model PaymentService {
  paymentId Int
  serviceId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  @@id([paymentId, serviceId])
  @@index([serviceId])
}

model Appointment {
  id          Int               @id @default(autoincrement())
  patientId   Int
  doctorId    Int?
  serviceId   Int?
  status      AppointmentStatus @default(WAITING)
  notes       String?
  scheduledAt DateTime          @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  service     Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  @@index([status, scheduledAt])
  @@index([patientId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  passwordHash         String
  passwordFingerprint  String?
  role                 UserRole  @default(OPERATOR)
  mustChangePassword   Boolean   @default(false)
  disabled             Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sessions             Session[]
  permissions          UserPermission[]
  doctorId             Int?      @unique
  doctor               Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  paymentsCreated      Payment[] @relation("CashierPayments")
  auditLogs             AuditLog[]
  loginHistory          LoginHistory[]

  @@index([role])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entity     String
  entityId   String?
  previous   String?
  next       String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([entity, entityId])
  @@index([createdAt])
}

model LoginHistory {
  id          Int      @id @default(autoincrement())
  userId      Int?
  username    String
  role        UserRole?
  loginAt     DateTime @default(now())
  logoutAt    DateTime?
  ipAddress   String?
  userAgent   String?
  success     Boolean
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([loginAt])
  @@index([username])
}

model Permission {
  id    Int    @id @default(autoincrement())
  code  String @unique
  label String
  users UserPermission[]
}

model UserPermission {
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([userId, permissionId])
}

model Session {
  id         String   @id
  userId     Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
