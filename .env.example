# Supabase pooled connection string for the application.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase direct connection string for Prisma schema changes.
DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
NUXT_SESSION_SECRET="replace-with-a-long-random-value"
# One-time secret used only for POST /api/auth/bootstrap. Do not expose it in the UI.
BOOTSTRAP_ADMIN_TOKEN="replace-with-a-different-long-random-value"
# First super admin credentials used for the initial bootstrap.
BOOTSTRAP_ADMIN_USERNAME="Husanov001"
BOOTSTRAP_ADMIN_PASSWORD="Husanov001"
