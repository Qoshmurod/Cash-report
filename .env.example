# PostgreSQL connection. Supabase: pooled URL (port 6543, ?pgbouncer=true) and direct URL (port 5432).
# Own server: both can be the same, e.g. postgresql://kassa:PASSWORD@localhost:5432/kassa
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
# docker-compose only: password of the bundled PostgreSQL container.
POSTGRES_PASSWORD="replace-with-a-strong-db-password"
# At least 32 random characters (e.g. openssl rand -hex 32).
NUXT_SESSION_SECRET="replace-with-a-long-random-value"
# One-time secret used only for POST /api/auth/bootstrap. Do not expose it in the UI.
BOOTSTRAP_ADMIN_TOKEN="replace-with-a-different-long-random-value"
# First super admin credentials used for the initial bootstrap.
BOOTSTRAP_ADMIN_USERNAME="Husanov001"
BOOTSTRAP_ADMIN_PASSWORD="Husanov001!99"
# Set to false only if the site is opened over plain http (no HTTPS); otherwise login cookies are rejected.
COOKIE_SECURE="true"
# Clinic time zone offset in minutes (Uzbekistan = 300). Used for "today", day closing and reports.
APP_TZ_OFFSET_MINUTES="300"
