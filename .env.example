# Docker: password of the bundled PostgreSQL container (docker-compose builds the connection URLs itself).
POSTGRES_PASSWORD="replace-with-a-strong-db-password"
# Only for running without Docker (npm run dev / PM2): PostgreSQL connection strings.
DATABASE_URL="postgresql://kassa:PASSWORD@localhost:5432/kassa"
DIRECT_URL="postgresql://kassa:PASSWORD@localhost:5432/kassa"
# At least 32 random characters (e.g. openssl rand -hex 32).
NUXT_SESSION_SECRET="replace-with-a-long-random-value"
# One-time secret used only for POST /api/auth/bootstrap. Do not expose it in the UI.
BOOTSTRAP_ADMIN_TOKEN="replace-with-a-different-long-random-value"
# Optional first super admin for POST /api/auth/bootstrap (deploy/install.sh generates its own).
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Set to false only if the site is opened over plain http (no HTTPS); otherwise login cookies are rejected.
COOKIE_SECURE="true"
# Clinic time zone offset in minutes (Uzbekistan = 300). Used for "today", day closing and reports.
APP_TZ_OFFSET_MINUTES="300"
# Server: time of day when an available update from GitHub is applied automatically.
UPDATE_TIME="22:00"
