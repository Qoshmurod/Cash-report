# ─────────────── General ───────────────
NODE_ENV=development
COMPOSE_PROJECT_NAME=shifoxona
TIMEZONE=Asia/Tashkent

# ─────────────── Host ports (change if busy) ───────────────
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# ─────────────── Backend ───────────────
APP_PORT=4000
APP_URL=http://localhost:4000
# comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# JSON body limit (base64 avatars/logos are validated separately, max 2 MB decoded)
BODY_LIMIT=5mb
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
LOGIN_THROTTLE_LIMIT=10
RUN_MIGRATIONS=true
RUN_SEED=true

# ─────────────── Database ───────────────
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=shifoxona
DATABASE_USER=shifoxona
DATABASE_PASSWORD=change_me_db_password
DATABASE_SSL=false
DATABASE_LOGGING=false

# ─────────────── JWT ───────────────
# generate: openssl rand -hex 48
JWT_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─────────────── Redis ───────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────── Seed (development defaults) ───────────────
SEED_ADMIN_LOGIN=admin01
SEED_ADMIN_PASSWORD=admin01
SEED_KIOSK_LOGIN=panel01
SEED_KIOSK_PASSWORD=panel01
# in production the seeded accounts are forced to change password on first login
SEED_DEMO_DATA=true

# ─────────────── Frontend ───────────────
# URL the *browser* uses to reach the backend
NUXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
NUXT_PUBLIC_WS_URL=http://localhost:4000
NUXT_PUBLIC_DEFAULT_LOCALE=uz
